# Copy outside the Git checkout, fill values, and chmod 600.
# TEST is the only default. Equity/F&O activation must be explicit.
CODEXBOT_MODE=TEST
CODEXBOT_EQUITY_ACTIVE=false
CODEXBOT_FNO_ACTIVE=false
CODEXBOT_GROUP_IDS=
CODEXBOT_AUTHORIZED_SOURCE_IDS=
CODEXBOT_LOG_GROUP_ID=
CODEXBOT_DATABASE_PATH=/var/lib/codexbot/codexbot.sqlite3
CODEXBOT_INSTRUMENT_CACHE_DIRECTORY=/var/lib/codexbot/instruments
CODEXBOT_INSTRUMENT_MAX_AGE_SECONDS=

# Credentials are intentionally blank. Never commit populated values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_SESSION_PATH=/var/lib/codexbot/udit.session
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
